{"seq": 1, "k": "place", "addr": "1", "kind": "program", "text": "import json\n\ndef _ledger():\n    try:\n        return [json.loads(l) for l in call(\"0\", \"show\").splitlines() if l.strip()]\n    except Exception:\n        return []\n\ndef _members():\n    try:\n        return json.loads(call(\"0\", \"who\"))\n    except Exception:\n        return []\n\ndef _broadcast():\n    eps = []\n    for row in _ledger():\n        if row.get(\"k\") == \"msg\":\n            b = row.get(\"body\", \"\")\n            if b.startswith(\"hello \"):\n                ep = b[6:].strip()\n                if ep and ep not in eps:\n                    eps.append(ep)\n    peers = \" \".join(eps)\n    for m in _members():\n        if m.get(\"kind\") == \"door\" and m.get(\"local\") is not True:\n            call(str(m.get(\"addr\")), \"peers \" + peers)\n\ndef run(m):\n    body = (m or {}).get(\"body\", \"\")\n    if body == \"ping\":\n        return \"pong\"\n    if body.startswith(\"placed\"):\n        _broadcast()\n        return \"\"\n    if body.startswith(\"hello \"):\n        ep = body[6:].strip()\n        if any(m.get(\"kind\") == \"door\" and m.get(\"text\") == ep for m in _members()):\n            _broadcast()\n        else:\n            call(\"c0\", \"add c3 door\\n\" + ep)\n        return \"\"\n    return \"\"", "bind": [], "in": true, "by": "1", "tag": "hub", "iface": "hello <endpoint> | ping -> pong"}
