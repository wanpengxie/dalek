{"seq": 1, "k": "place", "addr": "1", "kind": "program", "text": "import json, os\n\ndef _ledger():\n    try:\n        return [json.loads(l) for l in call(\"0\", \"show\").splitlines() if l.strip()]\n    except Exception:\n        return []\n\ndef _members():\n    try:\n        return json.loads(call(\"0\", \"who\"))\n    except Exception:\n        return []\n\ndef _hub(members):\n    for m in members:\n        if m.get(\"kind\") == \"door\" and m.get(\"tag\") == \"hub\":\n            return m\n    return None\n\ndef _ep():\n    return \"file:\" + os.path.abspath(\".\") + \"#\" + channel\n\ndef _has_hello(hub_addr):\n    me_str = str(me)\n    hub_str = str(hub_addr)\n    for row in _ledger():\n        if row.get(\"k\") == \"msg\" and str(row.get(\"from\")) == me_str and str(row.get(\"to\")) == hub_str and row.get(\"body\", \"\").startswith(\"hello \"):\n            return True\n    return False\n\ndef _need_spawn(hub_addr):\n    me_str = str(me)\n    hub_str = str(hub_addr)\n    last_ping = None\n    for row in _ledger():\n        if row.get(\"k\") == \"msg\" and str(row.get(\"from\")) == me_str and str(row.get(\"to\")) == hub_str and row.get(\"body\", \"\").strip() == \"ping\":\n            last_ping = int(row.get(\"seq\"))\n    if last_ping is None:\n        return False\n    for row in _ledger():\n        seq = row.get(\"seq\")\n        if seq is None:\n            continue\n        if int(seq) > last_ping:\n            if row.get(\"k\") == \"msg\" and str(row.get(\"from\")) == hub_str and str(row.get(\"to\")) == me_str and row.get(\"body\", \"\").strip() == \"pong\":\n                return False\n    return True\n\ndef _dir_of(hub):\n    text = hub.get(\"text\", \"\")\n    if \"file:\" in text and \"#\" in text:\n        return text.split(\"file:\", 1)[1].split(\"#\", 1)[0]\n    return \"\"\n\ndef run(m):\n    body = (m or {}).get(\"body\", \"\")\n    if body == \"ping\":\n        return \"pong\"\n    if body in (\"start\", \"up\", \"tick\"):\n        hub = _hub(_members())\n        if hub is None:\n            return \"\"\n        hub_addr = str(hub.get(\"addr\"))\n        if not _has_hello(hub_addr):\n            call(hub_addr, \"hello \" + _ep())\n            return \"\"\n        if body == \"tick\":\n            if _need_spawn(hub_addr):\n                d = _dir_of(hub)\n                if d:\n                    call(\"spawn\", d)\n            call(hub_addr, \"ping\")\n            for m in _members():\n                if m.get(\"kind\") == \"door\" and m.get(\"local\") is not True:\n                    a = str(m.get(\"addr\"))\n                    if a != hub_addr:\n                        call(a, \"ping\")\n            return \"\"\n    if body.startswith(\"peers \"):\n        own = _ep()\n        members = _members()\n        for ep in body[6:].strip().split():\n            if ep == own:\n                continue\n            if any(m.get(\"kind\") == \"door\" and m.get(\"text\") == ep for m in members):\n                continue\n            call(\"c0\", \"add c4 door\\n\" + ep)\n        return \"\"\n    if body.startswith(\"placed c4/\"):\n        n = body.split(\"/\", 1)[1].strip()\n        call(n, \"ping\")\n        return \"\"\n    return \"\"", "bind": ["spawn"], "in": true, "by": "1", "tag": "reporter", "iface": "tick | peers <endpoint..> | ping -> pong"}
